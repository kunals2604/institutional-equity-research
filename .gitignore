# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store

# Personal Claude Code settings (project settings in .claude/settings.json are shared)
.claude/settings.local.json

# Downloaded source documents (licensing/size): store references, not files
research/companies/*/runs/*/_cache/

# Scoreboard write lock
*.lock

# Exchange files cached by the outcome loop (scripts/outcomes.py)
research/outcomes/_cache/

# Agent transcripts kept past Claude Code's retention period (scripts/archive_transcripts.py)
research/_archive/

# The warehouse and the knowledge layers built from it (scripts/warehouse.py): rebuilt from public exchange files and
# the committed runs, so nothing in them needs git
research/warehouse/
research/knowledge/
research/companies/*/file/
