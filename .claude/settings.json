{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(python3 scripts/*)",
      "Bash(python3 -m unittest discover tests*)"
    ],
    "additionalDirectories": [
      "~/Documents/FilingForgeLibrary"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
